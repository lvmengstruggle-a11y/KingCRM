# 与 Java 后端并行时使用 8083，避免占用 8081
PORT=8083
HOST=0.0.0.0

# 复用现有 Cordys CRM MySQL，不新建库、不改表
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cordys-crm

# 与 Java spring.session.timeout=30d 对齐
SESSION_TTL_MS=2592000000

# 写入 /system/version 的 currentVersion
CRM_VERSION=node-0.1.0
